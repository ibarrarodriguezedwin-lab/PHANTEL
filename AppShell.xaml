<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="PHANTEL.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PHANTEL.Views"
       Shell.TabBarIsVisible="False"
       Shell.NavBarIsVisible="False"
       BackgroundColor="#121316"
       Title="PHANTEL">

    <TabBar>
        <ShellContent Route="ExplorarRoute"
                      ContentTemplate="{DataTemplate views:ExploracionPage}" />
        <ShellContent Route="MisCitasRoute"
                      ContentTemplate="{DataTemplate views:MisSolicitudesPage}" />
    </TabBar>

</Shell>