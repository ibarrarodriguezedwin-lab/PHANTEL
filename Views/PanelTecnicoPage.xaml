<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:helpers="clr-namespace:PHANTEL.Helpers"
             x:Class="PHANTEL.Views.PanelTecnicoPage"
             BackgroundColor="#1E1E1E"
             Title="PHANTEL - Panel de Atención Técnica">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Instancia del Convertidor de Base64 a Imagen -->
            <helpers:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- Encabezado del Técnico con Avatar Clicable -->
        <Border Grid.Row="0" Stroke="#007ACC" Padding="15" BackgroundColor="#1E1E1E">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">

                <!-- Datos de Bienvenida -->
                <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                    <Label x:Name="lblBienvenida" Text="Bienvenido" FontAttributes="Bold" FontSize="18" TextColor="White"/>
                    <Label x:Name="lblEspecialidad" Text="Especialidad:" TextColor="Gray" FontSize="14"/>
                </VerticalStackLayout>

                <!-- Avatar Circular del Técnico (abre DisplayActionSheet al dar clic) -->
                <ImageButton Grid.Column="1"
                             x:Name="btnPerfilTecnico" 
                             Aspect="AspectFill" 
                             WidthRequest="55" 
                             HeightRequest="55"
                             CornerRadius="28"
                             Source="dotnet_bot.png"
                             VerticalOptions="Center"
                             Clicked="OnPerfilTecnicoClicked" />

            </Grid>
        </Border>

        <Label Grid.Row="1" Text="Solicitudes de Trabajo Recibidas" FontAttributes="Bold" FontSize="16" TextColor="White" Margin="0,5,0,0"/>

        <!-- CollectionView de Solicitudes -->
        <CollectionView Grid.Row="2" x:Name="listCitasTecnico" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No tienes solicitudes pendientes por el momento." HorizontalOptions="Center" Margin="0,20" TextColor="Gray"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#007ACC" Margin="0,5" Padding="12" BackgroundColor="#252526">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <!-- Encabezado de la Tarjeta con Estado y Cobro -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Estado, StringFormat='Estado: {0}'}" FontAttributes="Bold" TextColor="#28A745"/>
                                <Label Grid.Column="1" Text="{Binding TarifaTraslado, StringFormat='Cobro Traslado: ${0:F2}'}" FontAttributes="Bold" TextColor="#007ACC"/>
                            </Grid>

                            <!-- Información General de la Cita -->
                            <Label Text="{Binding DescripcionFalla, StringFormat='Falla reportada: {0}'}" TextColor="White" FontAttributes="Bold"/>

                            <!-- Dirección del Domicilio ingresada por el Cliente -->
                            <Label Text="{Binding DireccionCliente, StringFormat='📍 Dirección: {0}'}" TextColor="#FFC107" FontSize="13" FontAttributes="Bold"/>

                            <!-- Fecha y Hora Programada por el Cliente -->
                            <Label Text="{Binding FechaHoraProgramada, StringFormat='📅 Cita Programada: {0:dd/MM/yyyy HH:mm hrs}'}" TextColor="#A5A6F6" FontAttributes="Bold" FontSize="13"/>

                            <Label Text="{Binding DistanciaKm, StringFormat='Distancia estimada al cliente: {0:F1} km'}" TextColor="Gray" FontSize="12"/>
                            <Label Text="{Binding FechaCreacion, StringFormat='Solicitado el: {0:dd/MM/yyyy HH:mm}'}" TextColor="Gray" FontSize="11"/>

                            <!-- Evidencia en Foto desde la Nube -->
                            <Image Source="{Binding EvidenciaRutaImagen, Converter={StaticResource Base64ToImageConverter}}" 
                                   HeightRequest="220" 
                                   MaximumWidthRequest="350"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,10"/>

                            <!-- Video de Evidencia -->
                            <toolkit:MediaElement Source="{Binding EvidenciaRutaVideo}" 
                                                  HeightRequest="180" 
                                                  ShouldAutoPlay="False" 
                                                  ShouldShowPlaybackControls="True" 
                                                  Volume="1.0" />

                            <!-- Acciones de Aceptar/Rechazar -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                                <Button Grid.Column="0" Text="Aceptar / Finalizar" 
                                        Clicked="OnAceptarFinalizarClicked" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#28A745" TextColor="White"/>
                                <Button Grid.Column="1" Text="Rechazar Cita" 
                                        Clicked="OnRechazarCitaClicked" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#DC3545" TextColor="White"/>
                            </Grid>

                            <!-- Abrir Chat Directo / Retroalimentación con el Cliente -->
                            <Button Text="💬 Chat / Retroalimentación Directa" 
                                    Clicked="OnAbrirChatClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="#17A2B8" TextColor="White" FontAttributes="Bold" Margin="0,5,0,0"/>

                            <!-- Abrir Ruta Directa en Navegador Web (Google Maps) -->
                            <Button Text="🌐 Abrir Ruta en Google Maps (Web)" 
                                    Clicked="OnAbrirGoogleMapsWebClicked" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="#007ACC" TextColor="White" FontAttributes="Bold" Margin="0,5,0,0"/>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>