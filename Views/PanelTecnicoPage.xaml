<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:helpers="clr-namespace:PHANTEL.Helpers"
             x:Class="PHANTEL.Views.PanelTecnicoPage"
             BackgroundColor="#121212"
             NavigationPage.HasNavigationBar="False"
             Title="PHANTEL - Panel de Atención Técnica">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *" Padding="20,16,20,0" RowSpacing="12">

        <!-- Encabezado -->
        <VerticalStackLayout Grid.Row="0" Spacing="14">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="14">
                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                    <Label x:Name="lblBienvenida"
                           Text="Bienvenido"
                           FontAttributes="Bold"
                           FontSize="24"
                           TextColor="#F2F2F7"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"/>
                    <Label x:Name="lblEspecialidad"
                           Text="Especialidad:"
                           TextColor="#8E8E93"
                           FontSize="13"/>
                    <!-- Estado de disponibilidad: al tocarlo abre Configuración -->
                    <Label x:Name="lblDisponibilidad"
                           Text=""
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#34C759">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDisponibilidadTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#2C2C2E"
                        WidthRequest="56"
                        HeightRequest="56"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28"/>
                    </Border.StrokeShape>
                    <ImageButton x:Name="btnPerfilTecnico"
                                 Aspect="AspectFill"
                                 WidthRequest="56"
                                 HeightRequest="56"
                                 Source="dotnet_bot.png"
                                 Clicked="OnPerfilTecnicoClicked" />
                </Border>
            </Grid>

            <Button x:Name="btnVerificacionKyc"
                    Text="Verifica tu identidad para obtener el sello"
                    Clicked="OnAbrirVerificacionKycClicked"
                    BackgroundColor="#1C1C1E"
                    TextColor="#E0A030"
                    FontSize="13"
                    FontAttributes="Bold"
                    HeightRequest="42"
                    CornerRadius="8"/>
        </VerticalStackLayout>

        <Label Grid.Row="1"
               Text="Solicitudes de trabajo"
               FontAttributes="Bold"
               FontSize="17"
               TextColor="#F2F2F7"
               Margin="0,6,0,0"/>

        <!-- Solicitudes -->
        <CollectionView Grid.Row="2" x:Name="listCitasTecnico" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No tienes solicitudes por el momento."
                       HorizontalOptions="Center"
                       Margin="0,24"
                       TextColor="#8E8E93"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1C1C1E" StrokeThickness="0" Margin="0,6" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#34C759"/>
                                <Label Grid.Column="1"
                                       Text="{Binding TarifaTraslado, StringFormat='Traslado ${0:F2}'}"
                                       FontSize="13"
                                       TextColor="#B0B0B5"/>
                            </Grid>

                            <Label Text="{Binding DescripcionFalla}"
                                   TextColor="#F2F2F7"
                                   FontAttributes="Bold"
                                   FontSize="16"/>

                            <Label Text="{Binding TextoUbicacion}"
                                   TextColor="#B0B0B5"
                                   FontSize="14"/>

                            <Label Text="{Binding FechaHoraProgramada, StringFormat='Cita: {0:dd/MM/yyyy HH:mm} h'}"
                                   TextColor="#F2F2F7"
                                   FontSize="13"/>

                            <Label Text="{Binding DistanciaKm, StringFormat='A {0:F1} km del cliente'}"
                                   IsVisible="{Binding EsDomicilio}"
                                   TextColor="#8E8E93"
                                   FontSize="12"/>
                            <Label Text="{Binding FechaCreacion, StringFormat='Solicitada el {0:dd/MM/yyyy HH:mm}'}"
                                   TextColor="#8E8E93"
                                   FontSize="12"/>

                            <Image Source="{Binding EvidenciaRutaImagen, Converter={StaticResource Base64ToImageConverter}}"
                                   IsVisible="{Binding TieneImagen}"
                                   HeightRequest="220"
                                   MaximumWidthRequest="350"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,8"/>

                            <toolkit:MediaElement Source="{Binding EvidenciaRutaVideo}"
                                                  IsVisible="{Binding TieneVideo}"
                                                  HeightRequest="180"
                                                  ShouldAutoPlay="False"
                                                  ShouldShowPlaybackControls="True"
                                                  Volume="1.0" />

                            <!-- Acciones principales -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">
                                <Button Grid.Column="0"
                                        Text="Aceptar cita"
                                        Clicked="OnAceptarCitaClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#007ACC"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="44"/>

                                <Button Grid.Column="1"
                                        Text="Finalizar trabajo"
                                        Clicked="OnFinalizarTrabajoClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent"
                                        BorderColor="#3A3A3C"
                                        BorderWidth="1"
                                        TextColor="#F2F2F7"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="44"/>
                            </Grid>

                            <!-- Acciones secundarias -->
                            <Grid ColumnDefinitions="*, *, *">
                                <Button Grid.Column="0"
                                        Text="Chat con el cliente"
                                        Clicked="OnAbrirChatClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent"
                                        TextColor="#4DA3E0"
                                        FontSize="13"
                                        Padding="0"
                                        HeightRequest="36"/>

                                <Button Grid.Column="1"
                                        Text="Ver ruta"
                                        IsVisible="{Binding EsDomicilio}"
                                        Clicked="OnAbrirGoogleMapsWebClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent"
                                        TextColor="#4DA3E0"
                                        FontSize="13"
                                        Padding="0"
                                        HeightRequest="36"/>

                                <Button Grid.Column="2"
                                        Text="Eliminar"
                                        Clicked="OnEliminarCitaClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent"
                                        TextColor="#E5534B"
                                        FontSize="13"
                                        Padding="0"
                                        HeightRequest="36"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>