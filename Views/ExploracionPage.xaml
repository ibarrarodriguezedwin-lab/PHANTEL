<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PHANTEL.Views.ExploracionPage"
             Title="PHANTEL - Buscar Técnico">

    <Grid RowDefinitions="Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- SearchBar y Filtros -->
        <SearchBar Grid.Row="0" x:Name="searchBarTecnicos" 
                   Placeholder="Buscar por nombre..." 
                   TextChanged="OnSearchTextChanged" />

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
            <Picker x:Name="pickerEspecialidad" Title="Filtrar por Especialidad"
                    SelectedIndexChanged="OnEspecialidadChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Todos</x:String>
                        <x:String>Plomería</x:String>
                        <x:String>Electricidad</x:String>
                        <x:String>Soporte de Cómputo</x:String>
                        <x:String>Cerrajería</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Button Grid.Column="1" Text="Limpiar" Clicked="OnLimpiarFiltrosClicked" Margin="5,0,0,0"/>
        </Grid>

        <!-- Lista de Técnicos Disponible -->
        <CollectionView Grid.Row="2" x:Name="listTecnicos" SelectionMode="Single"
                        SelectionChanged="OnTecnicoSeleccionado">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#007ACC" StrokeThickness="1" Margin="0,5" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                            <Image Source="{Binding FotoPerfil}" WidthRequest="50" HeightRequest="50" Aspect="AspectFill" />
                            <StackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Especialidad}" TextColor="Gray" FontSize="14" />
                            </StackLayout>
                            <StackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding CalificacionPromedio, StringFormat='⭐ {0:F1}'}" FontAttributes="Bold" />
                                <Button Text="Solicitar" Clicked="OnSolicitarClicked" CommandParameter="{Binding .}" HeightRequest="35" Padding="10,0"/>
                            </StackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>