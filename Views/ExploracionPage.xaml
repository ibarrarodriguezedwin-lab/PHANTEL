<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PHANTEL.Helpers"
             xmlns:models="clr-namespace:PHANTEL.Models"
             xmlns:controls="clr-namespace:PHANTEL.Controls"
             x:Class="PHANTEL.Views.ExploracionPage"
             BackgroundColor="#121212"
             Title="PHANTEL - Buscar Técnico">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:AvatarConverter x:Key="AvatarConverter" />
            <helpers:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Fila 0: saludo | Fila 1: oficios | Fila 2: búsqueda y orden | Fila 3: técnicos -->
        <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20,16,20,0" RowSpacing="14">

            <!-- 1. Encabezado -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="¿Qué necesitas arreglar hoy?"
                           TextColor="#8E8E93"
                           FontSize="13"/>
                    <Label x:Name="lblClienteNombre"
                           Text="Hola, Cliente"
                           FontAttributes="Bold"
                           FontSize="24"
                           TextColor="#F2F2F7"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#2C2C2E"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <ImageButton x:Name="btnPerfilCliente"
                                 Aspect="AspectFill"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Source="dotnet_bot.png"
                                 Clicked="OnPerfilClienteClicked" />
                </Border>
            </Grid>

            <!-- 2. Oficios -->
            <Grid Grid.Row="1" RowDefinitions="Auto, 1">
                <CollectionView Grid.Row="0"
                                x:Name="carruselCategorias"
                                IsVisible="False"
                                ItemsLayout="HorizontalList"
                                SelectionMode="None"
                                HeightRequest="46"
                                HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoriaIcono">
                            <VerticalStackLayout Margin="0,0,22,0"
                                                 Spacing="6"
                                                 VerticalOptions="End">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoriaTapped"/>
                                </VerticalStackLayout.GestureRecognizers>

                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Padding="2,4,2,0">
                                    <Grid WidthRequest="26" HeightRequest="26" VerticalOptions="Center">
                                        <Label Text="{Binding Emoji}"
                                               FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding SoloEmoji}"/>
                                        <Image Source="{Binding Imagen}"
                                               WidthRequest="26"
                                               HeightRequest="26"
                                               Aspect="AspectFit"
                                               IsVisible="{Binding TieneImagen}"/>
                                    </Grid>

                                    <Label Text="{Binding NombreCorto}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{Binding ColorTexto}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <BoxView HeightRequest="2"
                                         Color="White"
                                         IsVisible="{Binding EstaSeleccionada}"
                                         HorizontalOptions="Fill"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView Grid.Row="1" HeightRequest="1" Color="#2C2C2E" HorizontalOptions="Fill"/>
            </Grid>

            <!-- 3. Búsqueda y orden -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Border Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="#1C1C1E"
                        HeightRequest="48"
                        Padding="14,0,4,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Entry Grid.Column="0"
                               x:Name="entryBuscarTecnico"
                               Placeholder="Buscar por nombre u oficio"
                               PlaceholderColor="#8E8E93"
                               TextColor="#F2F2F7"
                               BackgroundColor="Transparent"
                               FontSize="14"
                               VerticalOptions="Center"
                               TextChanged="OnSearchTextChanged"/>

                        <Button Grid.Column="1"
                                x:Name="btnLimpiarRapido"
                                Text="✕"
                                IsVisible="False"
                                Clicked="OnLimpiarFiltrosClicked"
                                BackgroundColor="Transparent"
                                TextColor="#8E8E93"
                                FontSize="14"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#1C1C1E"
                        HeightRequest="48"
                        Padding="14,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOrdenarPillTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="Ordenar" FontSize="10" TextColor="#8E8E93"/>
                        <Label x:Name="lblOrdenActual"
                               Text="Recomendados"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#F2F2F7"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 4. Técnicos -->
            <CollectionView Grid.Row="3"
                            x:Name="listTecnicos"
                            SelectionMode="Single"
                            SelectionChanged="OnTecnicoSeleccionado">
                <CollectionView.Footer>
                    <!-- Espacio para que la barra inferior no tape al último técnico -->
                    <BoxView HeightRequest="95" Color="Transparent"/>
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <Label Text="No hay técnicos disponibles con esos filtros."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,30"
                           TextColor="#8E8E93"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Padding="0,14">
                                <Border Grid.Column="0"
                                        StrokeThickness="0"
                                        BackgroundColor="#2C2C2E"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="26"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding FotoPerfil, Converter={StaticResource AvatarConverter}}"
                                           WidthRequest="52"
                                           HeightRequest="52"
                                           Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Nombre}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="#F2F2F7"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="Verificado"
                                               IsVisible="{Binding EstaVerificado}"
                                               FontSize="12"
                                               TextColor="#4DA3E0"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Especialidad}"
                                           TextColor="#B0B0B5"
                                           FontSize="14" />
                                    <Label Text="{Binding TarifaPorHora, StringFormat='Tarifa base: ${0:F2}/hr'}"
                                           TextColor="#8E8E93"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="8">
                                    <Label Text="{Binding CalificacionPromedio, StringFormat='{0:F1} ★'}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#E0A030"
                                           HorizontalOptions="End"/>
                                    <Button Text="Solicitar"
                                            Clicked="OnSolicitarClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#007ACC"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            CornerRadius="8"
                                            HeightRequest="34"
                                            Padding="16,0"/>
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#2C2C2E"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Barra inferior -->
        <controls:LiquidGlassTabBar TabActivo="Explorar"/>
    </Grid>
</ContentPage>