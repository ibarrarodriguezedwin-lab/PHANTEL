<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PHANTEL.Helpers"
             xmlns:models="clr-namespace:PHANTEL.Models"
             x:Class="PHANTEL.Views.ExploracionPage"
             BackgroundColor="#1E1E1E"
             Title="PHANTEL - Buscar Técnico">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:AvatarConverter x:Key="AvatarConverter" />
            <helpers:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Fila 3 = carrusel de iconos, Fila 4 = lista de técnicos -->
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- Encabezado de Usuario Cliente con Clic Directo -->
        <Border Grid.Row="0" Stroke="#007ACC" Padding="12" BackgroundColor="#252526">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="lblClienteNombre" Text="Hola, Cliente" FontAttributes="Bold" FontSize="17" TextColor="White"/>
                    <Label Text="¿Qué servicio técnico necesitas hoy?" TextColor="Gray" FontSize="12"/>
                </VerticalStackLayout>

                <!-- Avatar Circular del Cliente (cierre autocontenido /> ) -->
                <ImageButton Grid.Column="1"
                             x:Name="btnPerfilCliente"
                             Aspect="AspectFill"
                             WidthRequest="48"
                             HeightRequest="48"
                             CornerRadius="24"
                             Source="dotnet_bot.png"
                             VerticalOptions="Center"
                             Clicked="OnPerfilClienteClicked" />
            </Grid>
        </Border>

        <!-- SearchBar -->
        <SearchBar Grid.Row="1" x:Name="searchBarTecnicos" 
                   Placeholder="Buscar por nombre..." 
                   TextColor="White"
                   PlaceholderColor="Gray"
                   BackgroundColor="#252526"
                   TextChanged="OnSearchTextChanged" />

        <!-- Ordenar resultados (la especialidad se elige con los iconos de abajo) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="8">
            <Picker x:Name="pickerOrden" Title="Ordenar por"
                    TitleColor="Gray" TextColor="White"
                    SelectedIndexChanged="OnOrdenChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Recomendados</x:String>
                        <x:String>Mejor calificados</x:String>
                        <x:String>Más cercanos</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Button Grid.Column="1" Text="Limpiar" Clicked="OnLimpiarFiltrosClicked" BackgroundColor="#2D2D30" TextColor="White"/>
        </Grid>

        <!-- Carrusel de iconos por especialidad (solo visible para clientes; se controla en el code-behind) -->
        <CollectionView Grid.Row="3"
                        x:Name="carruselCategorias"
                        IsVisible="False"
                        ItemsLayout="HorizontalList"
                        SelectionMode="None"
                        HeightRequest="136"
                        HorizontalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CategoriaIcono">
                    <Border WidthRequest="104"
                            Margin="0,0,8,0"
                            Padding="4,8"
                            BackgroundColor="#252526"
                            Stroke="Transparent"
                            StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <!-- Resalta el icono seleccionado -->
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding EstaSeleccionada}" Value="True">
                                <Setter Property="Stroke" Value="#007ACC"/>
                                <Setter Property="BackgroundColor" Value="#1F3A52"/>
                            </DataTrigger>
                        </Border.Triggers>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoriaTapped"/>
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Grid WidthRequest="72" HeightRequest="72">
                                <!-- Emoji provisional (se oculta si el icono tiene Imagen PNG/SVG) -->
                                <Label Text="{Binding Emoji}"
                                       FontSize="50"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding SoloEmoji}"/>
                                <!-- Imagen propia (Resources/Images) -->
                                <Image Source="{Binding Imagen}"
                                       Aspect="AspectFit"
                                       IsVisible="{Binding TieneImagen}"/>
                            </Grid>
                            <Label Text="{Binding NombreCorto}"
                                   FontSize="11"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Lista de Técnicos Disponibles -->
        <CollectionView Grid.Row="4" x:Name="listTecnicos" SelectionMode="Single"
                        SelectionChanged="OnTecnicoSeleccionado">
            <CollectionView.EmptyView>
                <Label Text="No se encontraron técnicos con los filtros seleccionados." 
                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,30" TextColor="Gray"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#007ACC" StrokeThickness="1" Margin="0,5" Padding="12" BackgroundColor="#252526">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">

                            <!-- Foto de Perfil del Técnico procesada desde Base64 -->
                            <Border Grid.Column="0" Stroke="#007ACC" WidthRequest="50" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="25"/>
                                </Border.StrokeShape>
                                <Image Source="{Binding FotoPerfil, Converter={StaticResource AvatarConverter}}" 
                                       WidthRequest="50" HeightRequest="50" Aspect="AspectFill" />
                            </Border>

                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                                <Label Text="{Binding InsigniaVerificacionTexto}"
                                       IsVisible="{Binding EstaVerificado}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#00D2FF"/>
                                <Label Text="{Binding Especialidad}" TextColor="#FFC107" FontSize="13" />
                                <Label Text="{Binding TarifaPorHora, StringFormat='Tarifa base: ${0:F2}/hr'}" TextColor="Gray" FontSize="11" />
                            </StackLayout>

                            <StackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="5">
                                <Label Text="{Binding CalificacionPromedio, StringFormat='⭐ {0:F1}'}" FontAttributes="Bold" TextColor="#28A745" HorizontalOptions="End"/>
                                <Button Text="Solicitar" Clicked="OnSolicitarClicked" CommandParameter="{Binding .}" BackgroundColor="#007ACC" TextColor="White" HeightRequest="36" Padding="12,0"/>
                            </StackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>