<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PHANTEL.Helpers"
             xmlns:models="clr-namespace:PHANTEL.Models"
             xmlns:controls="clr-namespace:PHANTEL.Controls"
             x:Class="PHANTEL.Views.ExploracionPage"
             BackgroundColor="black"
             Title="PHANTEL - Buscar Técnico">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:AvatarConverter x:Key="AvatarConverter" />
            <helpers:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Fila 0: Saludo | Fila 1: Pestañas Uber | Fila 2: Buscador Píldora | Fila 3: Lista Técnicos -->
        <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="16,12,16,0" RowSpacing="12">

            <!-- 1. Encabezado Liquid Glass -->
            <Border Grid.Row="0"
                    Stroke="#2EFFFFFF"
                    StrokeThickness="1"
                    Padding="14,10"
                    BackgroundColor="#14FFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                        <Label x:Name="lblClienteNombre"
                               Text="Hola, Cliente"
                               FontAttributes="Bold"
                               FontSize="17"
                               TextColor="White"/>
                        <Label Text="¿Qué servicio técnico necesitas hoy?"
                               TextColor="#A1A7B3"
                               FontSize="12"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Stroke="#55FFFFFF"
                            StrokeThickness="1.2"
                            WidthRequest="46"
                            HeightRequest="46"
                            Padding="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="23"/>
                        </Border.StrokeShape>
                        <ImageButton x:Name="btnPerfilCliente"
                                     Aspect="AspectFill"
                                     WidthRequest="46"
                                     HeightRequest="46"
                                     Source="dotnet_bot.png"
                                     Clicked="OnPerfilClienteClicked" />
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Pestañas Horizontales Compactas Estilo Uber -->
            <Grid Grid.Row="1" RowDefinitions="Auto, 1">
                <CollectionView Grid.Row="0"
                                x:Name="carruselCategorias"
                                IsVisible="False"
                                ItemsLayout="HorizontalList"
                                SelectionMode="None"
                                HeightRequest="46"
                                HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoriaIcono">
                            <VerticalStackLayout Margin="0,0,22,0"
                                                 Spacing="6"
                                                 VerticalOptions="End">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoriaTapped"/>
                                </VerticalStackLayout.GestureRecognizers>

                                <!-- Icono pequeño + Texto alineados horizontalmente -->
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Padding="2,4,2,0">
                                    <Grid WidthRequest="26" HeightRequest="26" VerticalOptions="Center">
                                        <Label Text="{Binding Emoji}"
                                               FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding SoloEmoji}"/>
                                        <Image Source="{Binding Imagen}"
                                               WidthRequest="26"
                                               HeightRequest="26"
                                               Aspect="AspectFit"
                                               IsVisible="{Binding TieneImagen}"/>
                                    </Grid>

                                    <Label Text="{Binding NombreCorto}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{Binding ColorTexto}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <!-- Indicador inferior blanco estilo Uber -->
                                <BoxView HeightRequest="3.5"
                                         CornerRadius="2"
                                         Color="White"
                                         IsVisible="{Binding EstaSeleccionada}"
                                         HorizontalOptions="Fill"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Línea divisoria sutil estilo Uber -->
                <BoxView Grid.Row="1" HeightRequest="1" Color="#24FFFFFF" HorizontalOptions="Fill"/>
            </Grid>

            <!-- 3. Barra de Búsqueda Píldora Redondeada Liquid Glass (debajo de los iconos) -->
            <Border Grid.Row="2"
                    Stroke="#3AFFFFFF"
                    StrokeThickness="1.2"
                    BackgroundColor="#1AFFFFFF"
                    HeightRequest="52"
                    Padding="14,0,8,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <!-- Icono lupa -->
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="16"
                           TextColor="White"
                           VerticalOptions="Center"/>

                    <!-- Campo de búsqueda sin bordes nativos -->
                    <Entry Grid.Column="1"
                       x:Name="entryBuscarTecnico"
                       Placeholder="Buscar técnico..."
                       PlaceholderColor="#9CA3AF"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       FontSize="13"
                       VerticalOptions="Center"
                       TextChanged="OnSearchTextChanged"/>

                    <!-- Botón limpiar rápido (solo aparece cuando hay filtro/texto) -->
                    <Button Grid.Column="2"
                            x:Name="btnLimpiarRapido"
                            Text="✕"
                            IsVisible="False"
                            Clicked="OnLimpiarFiltrosClicked"
                            BackgroundColor="Transparent"
                            TextColor="#9CA3AF"
                            FontSize="14"
                            WidthRequest="32"
                            HeightRequest="32"
                            Padding="0"
                            VerticalOptions="Center"/>

                    <!-- Cápsula interna estilo "Más tarde" de Uber para Ordenar / Filtrar -->
                    <Border Grid.Column="3"
                            Stroke="#30FFFFFF"
                            StrokeThickness="1"
                            BackgroundColor="#24FFFFFF"
                            HeightRequest="36"
                            Padding="12,0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOrdenarPillTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="⇅" FontSize="13" TextColor="White" VerticalOptions="Center"/>
                            <Label x:Name="lblOrdenActual"
                                   Text="Recomendados"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. Lista de Técnicos Disponibles (Tarjetas Liquid Glass) -->
            <CollectionView Grid.Row="3"
                            x:Name="listTecnicos"
                            SelectionMode="Single"
                            SelectionChanged="OnTecnicoSeleccionado">
                <CollectionView.Footer>
                    <!-- Espacio inferior para que la barra flotante no tape al último técnico -->
                    <BoxView HeightRequest="95" Color="Transparent"/>
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <Label Text="No se encontraron técnicos con los filtros seleccionados." 
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,30"
                           TextColor="#9CA3AF"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#2AFFFFFF"
                                StrokeThickness="1"
                                Margin="0,5"
                                Padding="12"
                                BackgroundColor="#14FFFFFF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <!-- Foto de Perfil del Técnico -->
                                <Border Grid.Column="0"
                                        Stroke="#45FFFFFF"
                                        StrokeThickness="1.2"
                                        WidthRequest="52"
                                        HeightRequest="52">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="26"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding FotoPerfil, Converter={StaticResource AvatarConverter}}" 
                                           WidthRequest="52"
                                           HeightRequest="52"
                                           Aspect="AspectFill" />
                                </Border>

                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Nombre}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="White"/>
                                    <Label Text="{Binding InsigniaVerificacionTexto}"
                                           IsVisible="{Binding EstaVerificado}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#00D2FF"/>
                                    <Label Text="{Binding Especialidad}"
                                           TextColor="#FFC107"
                                           FontSize="13" />
                                    <Label Text="{Binding TarifaPorHora, StringFormat='Tarifa base: ${0:F2}/hr'}"
                                           TextColor="#9CA3AF"
                                           FontSize="11" />
                                </StackLayout>

                                <StackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="6">
                                    <Label Text="{Binding CalificacionPromedio, StringFormat='⭐ {0:F1}'}"
                                           FontAttributes="Bold"
                                           TextColor="#28A745"
                                           HorizontalOptions="End"/>
                                    <Button Text="Solicitar"
                                            Clicked="OnSolicitarClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#007ACC"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="16"
                                            HeightRequest="34"
                                            Padding="14,0"/>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Barra flotante Liquid Glass estilo Uber / iOS 26 -->
        <controls:LiquidGlassTabBar TabActivo="Explorar"/>
    </Grid>
</ContentPage>