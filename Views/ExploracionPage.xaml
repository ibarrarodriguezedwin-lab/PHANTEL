<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PHANTEL.Helpers"
             xmlns:models="clr-namespace:PHANTEL.Models"
             xmlns:controls="clr-namespace:PHANTEL.Controls"
             x:Class="PHANTEL.Views.ExploracionPage"
             BackgroundColor="#121212"
             Title="PHANTEL - Buscar Técnico">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:AvatarConverter x:Key="AvatarConverter" />
            <helpers:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- MARCA DE AGUA MONOGRAMA PP DIRECTO EN XAML -->
        <Grid InputTransparent="True" IsClippedToBounds="True">
            <Grid WidthRequest="240"
                  HeightRequest="260"
                  Opacity="0.06"
                  HorizontalOptions="End"
                  VerticalOptions="End"
                  Margin="0,0,-25,55">
                <Label Text="P"
                       FontFamily="Georgia"
                       FontSize="230"
                       TextColor="White"
                       HorizontalOptions="Start"
                       VerticalOptions="End"/>
                <Label Text="P"
                       FontFamily="Georgia"
                       FontSize="230"
                       TextColor="#4DA3E0"
                       Margin="42,0,0,28"
                       HorizontalOptions="Start"
                       VerticalOptions="End"/>
            </Grid>
        </Grid>

        <!-- Fila 0: banner aviso conducta | 1: saludo | 2: oficios | 3: búsqueda | 4: filtros | 5: técnicos -->
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *" Padding="20,16,20,0" RowSpacing="12">

            <!-- 0. BANNER DE AVISO DE CONDUCTA (SOLO SI EL ADMIN ENVIÓ ADVERTENCIA) -->
            <Border Grid.Row="0"
                    x:Name="cardAvisoConducta"
                    IsVisible="False"
                    Stroke="#4A351C"
                    StrokeThickness="1"
                    BackgroundColor="#241C14"
                    Padding="14,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Path Grid.Column="0"
                              Data="M 1,21 L 23,21 L 12,2 L 1,21 Z M 13,18 L 11,18 L 11,16 L 13,16 L 13,18 Z M 13,14 L 11,14 L 11,10 L 13,10 L 13,14 Z"
                              Fill="#F59E0B"
                              Aspect="Uniform"
                              WidthRequest="18"
                              HeightRequest="18"
                              VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Aviso de Conducta PHANTEL"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#F59E0B"
                               VerticalOptions="Center"/>
                        <Border Grid.Column="2"
                                Stroke="#4A351C"
                                StrokeThickness="1"
                                BackgroundColor="#1C1C1E"
                                Padding="10,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMarcarAvisoLeidoTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="Entendido"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#F2F2F7"/>
                        </Border>
                    </Grid>
                    <Label x:Name="lblMensajeAvisoConducta"
                           Text=""
                           FontSize="12"
                           TextColor="#E5E5EA"/>
                </VerticalStackLayout>
            </Border>

            <!-- 1. Encabezado -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="¿Qué necesitas arreglar hoy?"
                           TextColor="#8E8E93"
                           FontSize="13"/>
                    <Label x:Name="lblClienteNombre"
                           Text="Hola, Cliente"
                           FontAttributes="Bold"
                           FontSize="24"
                           TextColor="#F2F2F7"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#2C2C2E"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <ImageButton x:Name="btnPerfilCliente"
                                 Aspect="AspectFill"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Source="dotnet_bot.png"
                                 Clicked="OnPerfilClienteClicked" />
                </Border>
            </Grid>

            <!-- 2. Oficios (solo texto, sin iconos) -->
            <CollectionView Grid.Row="2"
                            x:Name="carruselCategorias"
                            IsVisible="False"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HeightRequest="40"
                            HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoriaIcono">
                        <Border BackgroundColor="{Binding ColorFondo}"
                                StrokeThickness="0"
                                Padding="16,0"
                                Margin="0,0,8,0"
                                HeightRequest="36"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoriaTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding NombreCorto}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{Binding ColorTexto}"
                                   VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 3. Búsqueda -->
            <Border Grid.Row="3"
                    StrokeThickness="0"
                    BackgroundColor="#1C1C1E"
                    HeightRequest="48"
                    Padding="14,0,4,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Entry Grid.Column="0"
                           x:Name="entryBuscarTecnico"
                           Placeholder="Buscar por nombre u oficio"
                           PlaceholderColor="#8E8E93"
                           TextColor="#F2F2F7"
                           BackgroundColor="Transparent"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextChanged="OnSearchTextChanged"/>

                    <Button Grid.Column="1"
                            x:Name="btnLimpiarRapido"
                            Text="✕"
                            IsVisible="False"
                            Clicked="OnLimpiarFiltrosClicked"
                            BackgroundColor="Transparent"
                            TextColor="#8E8E93"
                            FontSize="14"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- 4. Filtros: tipo de atención y orden -->
            <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="10">
                <Border Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="#1C1C1E"
                        HeightRequest="48"
                        Padding="14,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnModalidadPillTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="Atención" FontSize="10" TextColor="#8E8E93"/>
                        <Label x:Name="lblModalidadActual"
                               Text="Todas"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#F2F2F7"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#1C1C1E"
                        HeightRequest="48"
                        Padding="14,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOrdenarPillTapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="Ordenar" FontSize="10" TextColor="#8E8E93"/>
                        <Label x:Name="lblOrdenActual"
                               Text="Recomendados"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#F2F2F7"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 5. Técnicos -->
            <CollectionView Grid.Row="5"
                            x:Name="listTecnicos"
                            SelectionMode="Single"
                            SelectionChanged="OnTecnicoSeleccionado">
                <CollectionView.Footer>
                    <!-- Espacio para que la barra inferior no tape al último técnico -->
                    <BoxView HeightRequest="95" Color="Transparent"/>
                </CollectionView.Footer>

                <CollectionView.EmptyView>
                    <Label Text="No hay técnicos disponibles con esos filtros."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,30"
                           TextColor="#8E8E93"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Padding="0,14">
                                <Border Grid.Column="0"
                                        StrokeThickness="0"
                                        BackgroundColor="#2C2C2E"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="26"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding FotoPerfil, Converter={StaticResource AvatarConverter}}"
                                           WidthRequest="52"
                                           HeightRequest="52"
                                           Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Nombre}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="#F2F2F7"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="Verificado"
                                               IsVisible="{Binding EstaVerificado}"
                                               FontSize="12"
                                               TextColor="#4DA3E0"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Especialidad}"
                                           TextColor="#B0B0B5"
                                           FontSize="14" />
                                    <Label Text="{Binding TextoModalidad}"
                                           TextColor="#8E8E93"
                                           FontSize="12" />
                                    <Label Text="{Binding TarifaPorHora, StringFormat='Tarifa base: ${0:F2}/hr'}"
                                           TextColor="#8E8E93"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="4">
                                    <Label Text="{Binding TextoEstrellas}"
                                           IsVisible="{Binding MostrarEstrellas}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#E0A030"
                                           HorizontalOptions="End"/>
                                    <Label Text="{Binding TextoNuevo}"
                                           IsVisible="{Binding MostrarNuevo}"
                                           FontSize="12"
                                           TextColor="#8E8E93"
                                           HorizontalOptions="End"/>
                                    <Label Text="›"
                                           FontSize="26"
                                           TextColor="#5A5A5F"
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#2C2C2E"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Barra inferior -->
        <controls:LiquidGlassTabBar TabActivo="Explorar"/>
    </Grid>
</ContentPage>