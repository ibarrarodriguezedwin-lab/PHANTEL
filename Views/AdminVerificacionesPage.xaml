<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PHANTEL.Views.AdminVerificacionesPage"
             BackgroundColor="#121212"
             Title="Validación de Técnicos (KYC)">

    <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="12">
        <Label Grid.Row="0"
               Text="🪪 Solicitudes de Verificación Pendientes"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#00D2FF"/>

        <CollectionView Grid.Row="1" x:Name="listPendientes">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                    <Label Text="✅ No hay técnicos pendientes de verificación."
                           TextColor="#B0C4DE"
                           FontSize="15"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#007ACC" Margin="0,6" Padding="14" BackgroundColor="#1C1C1E" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="{Binding Email}" FontSize="13" TextColor="#B0C4DE"/>
                            <Label Text="{Binding Especialidad, StringFormat='Especialidad: {0}'}" FontSize="13" TextColor="#00D2FF"/>

                            <Button Text="🔍 Revisar INE y Dictaminar"
                                    Clicked="OnRevisarDocumentosClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#007ACC"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>