<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PHANTEL.Views.LoginPage"
             BackgroundColor="#1E1E1E"
             Title="Acceso PHANTEL">

    <Grid VerticalOptions="Center" Padding="30">
        <Border Stroke="#007ACC" StrokeThickness="2" Padding="25" BackgroundColor="#252526">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">
                <Label Text="PHANTEL" FontSize="32" FontAttributes="Bold" TextColor="#007ACC" HorizontalOptions="Center"/>
                <Label Text="Inicia sesión según tu rol" FontSize="14" TextColor="Gray" HorizontalOptions="Center"/>

                <Entry x:Name="entryEmail" Placeholder="Correo electrónico" TextColor="White" PlaceholderColor="Gray"/>
                <Entry x:Name="entryPassword" Placeholder="Contraseña" IsPassword="True" TextColor="White" PlaceholderColor="Gray"/>

                <Label x:Name="lblError" TextColor="Red" IsVisible="False" HorizontalOptions="Center"/>

                <Button Text="Ingresar" Clicked="OnIngresarClicked" BackgroundColor="#007ACC" TextColor="White" FontAttributes="Bold" Margin="0,10,0,0"/>

                <Label Text="Cuentas de prueba:" TextColor="Gray" FontSize="12" Margin="0,15,0,0"/>
                <Label Text="• Cliente: cliente@phantel.com / 123" TextColor="DarkGray" FontSize="11"/>
                <Label Text="• Técnico: tecnico@phantel.com / 123" TextColor="DarkGray" FontSize="11"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>